# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
.turbo/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Environment / secrets — profile/.env.example IS committed
profile/.env
profile/.env.*
!profile/.env.example

# User-specific profile files (templates with .example are committed)
profile/USER.md
profile/mcp.json
profile/skills/*
!profile/skills/.gitkeep

# Google Calendar OAuth credentials (Desktop app JSON do Google Cloud Console)
profile/google-credentials.json

# Vault Obsidian (notas pessoais — context.example/ é o template committed)
context/
!context/.gitkeep

# SQLite
*.db
*.db-journal
*.db-wal
*.db-shm

# Coverage / test artifacts
coverage/
.nyc_output/

# Temporary
tmp/
.tmp/

# Claude Code local state
.claude/local/

# Screenshots dropados na raiz durante sessões — não vão pro repo
/image*.png
/image*.jpg
/image*.jpeg
