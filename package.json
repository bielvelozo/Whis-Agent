{
  "name": "whis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "quality-gate": "turbo run lint typecheck test --concurrency=10",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "docker:build": "docker compose -f infra/docker-compose.yml --project-directory . build",
    "docker:up": "docker compose -f infra/docker-compose.yml --project-directory . up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml --project-directory . down",
    "docker:logs": "docker compose -f infra/docker-compose.yml --project-directory . logs -f",
    "docker:sh": "docker compose -f infra/docker-compose.yml --project-directory . exec whis-worker bash",
    "docker:setup-token": "docker compose -f infra/docker-compose.yml --project-directory . run --rm whis-worker claude setup-token",
    "docker:up:local": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.local.yml --project-directory . up -d",
    "docker:down:local": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.local.yml --project-directory . down",
    "docker:logs:local": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.local.yml --project-directory . logs -f",
    "docker:sh:local": "docker compose -f infra/docker-compose.yml -f infra/docker-compose.local.yml --project-directory . exec whis-worker bash",
    "evolution:setup": "sh infra/setup-evolution.sh",
    "evolution:logs": "docker compose -f infra/docker-compose.yml --project-directory . logs -f evolution-api",
    "telegram:setup": "tsx infra/setup-telegram.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "grammy": "^1.42.0",
    "knip": "^6.4.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
