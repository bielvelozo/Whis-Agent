# Default: detect text vs binary, normalize to LF in working tree.
# Avoids Biome lint failures on Windows checkouts (core.autocrlf=true).
* text=auto eol=lf

# Shell scripts must be LF (run inside Linux container)
*.sh text eol=lf

# Same for the entrypoint script symlink target name
infra/entrypoint.sh text eol=lf
infra/setup-evolution.sh text eol=lf
